# TALAS environment variables.
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Vite only exposes vars prefixed with VITE_ to the client.

# HTTPS URL of the sync endpoint (AWS Lambda `talasFunction`, region ap-southeast-2),
# exposed via API Gateway or a Lambda Function URL. It must accept `POST /sync`.
# Leave unset to run fully offline (sync is skipped gracefully).
VITE_TALAS_SYNC_URL="https://lxaz6gbz4xbgptwiyx56o7mh640cykfb.lambda-url.ap-southeast-2.on.aws/"
